# Copie este arquivo para ".env" (cp .env.example .env) e ajuste se precisar.
# O arquivo .env NUNCA vai para o GitHub.

# --- Banco de dados (PostgreSQL) ---
POSTGRES_DB=adotapet
POSTGRES_USER=adotapet
POSTGRES_PASSWORD=adotapet_dev

# --- Django ---
DJANGO_SECRET_KEY=troque-esta-chave-por-uma-longa-e-aleatoria
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,backend
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Frontend (React) ---
# Endereço da API visto pelo navegador
VITE_API_URL=http://localhost:8000
